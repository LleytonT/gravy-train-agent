# --- AI Gateway (required for agent + classification) ---
AI_GATEWAY_API_KEY=

# Model overrides (AI Gateway ids)
AGENT_MODEL=anthropic/claude-sonnet-5
CLASSIFY_MODEL=anthropic/claude-haiku-4.5

# Eve eval fixture agent (GS-009). Set by `pnpm test:evals`.
# Uses mockModel + in-memory tool state; do not set in production.
# GRAVY_SCOUT_EVAL_FIXTURE=1

# --- Member session (Telegram Login for web) ---
# Optional dedicated secret for gs_member_session JWTs. Falls back to
# TELEGRAM_BOT_TOKEN when unset.
# MEMBER_SESSION_SECRET=

# --- Neon Postgres (required) ---
# Provision with `vercel integration add neon`, then pull development env:
# `vercel env pull .env.local --yes`
# Use the pooled URL at runtime and the direct URL for Drizzle migrations.
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# --- Resend inbound job alerts (GS-006) ---
# Production: gravy.sh via Marketplace resource gravy-scout-email.
#   vercel integration add resend --name gravy-scout-email --plan free \
#     -m domain=gravy.sh -m region=us-east-1
# Receiving enabled on gravy.sh; webhook email.received → https://gravy.sh/api/inbound/resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Receiving domain only (no @). Production: gravy.sh
RESEND_INBOUND_DOMAIN=gravy.sh
# Set by Marketplace when Resend is connected
# RESEND_EMAIL_DOMAIN=gravy.sh
# Optional: hours to keep full inbound bodies in payload (default 168 = 7 days)
# INBOUND_FULL_BODY_RETENTION_HOURS=168

# --- Capture (local Mac) ---
CAPTURE_PROFILE_DIR=./.browser-profile
# After deploy: sync captured items to the hosted agent
CAPTURE_SYNC_URL=https://YOUR_DEPLOYMENT/eve/v1/capture-sync/items
CAPTURE_SYNC_TOKEN=
# SYNC_ONLY=1

# --- Telegram (primary chat + member identity + web Login) ---
# Create a bot with @BotFather, then set:
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Hostname for the Login Widget (no https://). Production default: gravy.sh
# Must match BotFather → /setdomain (or Login Widget Allowed URLs).
# TELEGRAM_LOGIN_DOMAIN=gravy.sh
# NEXT_PUBLIC_APP_URL=https://gravy.sh
# Random secret; must match setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Optional TTL for one-time web→Telegram link/login tokens (seconds, default 900)
# TELEGRAM_LINK_TOKEN_TTL_SECONDS=900
# After deploy:
# 1) BotFather → /setdomain → @YourBot → gravy.sh
# 2) Register webhook:
# curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#   -H "Content-Type: application/json" \
#   -d '{"url":"https://YOUR_DEPLOY/eve/v1/telegram","secret_token":"YOUR_SECRET","allowed_updates":["message","callback_query"]}'
# Deep-link web login (POST /api/auth/telegram/challenge) works even when
# /setdomain is missing; the Login Widget will show "Bot domain invalid" until set.

# Optional profile path override
# USER_PROFILE_PATH=agent/sandbox/workspace/memory/user-profile.md
