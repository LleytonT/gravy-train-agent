# --- AI Gateway (required for agent + classification) ---
AI_GATEWAY_API_KEY=

# Model overrides (AI Gateway ids — swap freely for multi-LLM choice / fine-tunes)
AGENT_MODEL=anthropic/claude-sonnet-5
CLASSIFY_MODEL=anthropic/claude-haiku-4.5
# Eval / compare sweeps (comma-separated Gateway ids)
# CLASSIFY_MODELS=anthropic/claude-haiku-4.5,openai/gpt-5-mini
# EVAL_CLASSIFY_MODEL=
# EVAL_LIVE=1
# EVAL_BASE_URL=http://127.0.0.1:2000

# --- SQLite / libSQL ---
# Local file (default). For Phase 5 on Vercel, point at Turso:
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
DATABASE_URL=file:./data/gravy-scout.db

# --- Capture (local Mac) ---
CAPTURE_PROFILE_DIR=./.browser-profile
# After deploy: sync captured items to the hosted agent
CAPTURE_SYNC_URL=https://YOUR_DEPLOYMENT/eve/v1/capture-sync/items
CAPTURE_SYNC_TOKEN=
# SYNC_ONLY=1

# --- Twilio WhatsApp (Phase 4) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Your number: whatsapp:+61XXXXXXXXX
WHATSAPP_TO=
# Comma-separated allowlist (defaults to WHATSAPP_TO)
WHATSAPP_ALLOW_FROM=
# Public URL Twilio signs against (tunnel or production)
TWILIO_WEBHOOK_URL=
PUBLIC_BASE_URL=

# Optional profile path override
# USER_PROFILE_PATH=agent/sandbox/workspace/memory/user-profile.md
