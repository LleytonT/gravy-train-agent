# --- AI Gateway (required for agent + classification) ---
AI_GATEWAY_API_KEY=

# Model overrides (AI Gateway ids)
AGENT_MODEL=anthropic/claude-sonnet-5
CLASSIFY_MODEL=anthropic/claude-haiku-4.5

# --- SQLite / libSQL ---
# Local file (default). For Phase 5 on Vercel, point at Turso:
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
DATABASE_URL=file:./data/gravy-scout.db

# --- Capture (local Mac) ---
CAPTURE_PROFILE_DIR=./.browser-profile
# After deploy: sync captured items to the hosted agent
CAPTURE_SYNC_URL=https://YOUR_DEPLOYMENT/eve/v1/capture-sync/items
CAPTURE_SYNC_TOKEN=
# SYNC_ONLY=1

# --- Telegram (primary push + chat) ---
# Create a bot with @BotFather, then set:
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random secret; must match setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# After deploy:
# curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#   -H "Content-Type: application/json" \
#   -d '{"url":"https://YOUR_DEPLOY/eve/v1/telegram","secret_token":"YOUR_SECRET","allowed_updates":["message","callback_query"]}'

# --- Twilio WhatsApp (optional fallback) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Your number: whatsapp:+61XXXXXXXXX
WHATSAPP_TO=
# Comma-separated allowlist (defaults to WHATSAPP_TO)
WHATSAPP_ALLOW_FROM=
# Public URL Twilio signs against (tunnel or production)
TWILIO_WEBHOOK_URL=
PUBLIC_BASE_URL=

# Optional profile path override
# USER_PROFILE_PATH=agent/sandbox/workspace/memory/user-profile.md
