# --- AI Gateway (required for agent + classification) ---
AI_GATEWAY_API_KEY=

# Model overrides (AI Gateway ids)
AGENT_MODEL=anthropic/claude-sonnet-5
CLASSIFY_MODEL=anthropic/claude-haiku-4.5

# --- Clerk (required for web + Eve browser auth) ---
# Provision with `vercel integration add clerk`, then:
# `vercel env pull .env.local --yes`
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional comma-separated origins for Clerk JWT azp checks
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://your-app.vercel.app
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Neon Postgres (required) ---
# Provision with `vercel integration add neon`, then pull development env:
# `vercel env pull .env.local --yes`
# Use the pooled URL at runtime and the direct URL for Drizzle migrations.
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# --- Capture (local Mac) ---
CAPTURE_PROFILE_DIR=./.browser-profile
# After deploy: sync captured items to the hosted agent
CAPTURE_SYNC_URL=https://YOUR_DEPLOYMENT/eve/v1/capture-sync/items
CAPTURE_SYNC_TOKEN=
# SYNC_ONLY=1

# --- Telegram (primary push + chat) ---
# Create a bot with @BotFather, then set:
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random secret; must match setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# After deploy:
# curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#   -H "Content-Type: application/json" \
#   -d '{"url":"https://YOUR_DEPLOY/eve/v1/telegram","secret_token":"YOUR_SECRET","allowed_updates":["message","callback_query"]}'

# --- Twilio WhatsApp (optional fallback) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Your number: whatsapp:+61XXXXXXXXX
WHATSAPP_TO=
# Comma-separated allowlist (defaults to WHATSAPP_TO)
WHATSAPP_ALLOW_FROM=
# Public URL Twilio signs against (tunnel or production)
TWILIO_WEBHOOK_URL=
PUBLIC_BASE_URL=

# Optional profile path override
# USER_PROFILE_PATH=agent/sandbox/workspace/memory/user-profile.md
