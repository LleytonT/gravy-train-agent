{
  "name": "gravy-scout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:tui": "eve dev",
    "dev:no-ui": "eve dev --no-ui",
    "build": "next build --webpack",
    "build:eve": "eve build",
    "start": "next start",
    "start:eve": "eve start",
    "info": "eve info",
    "seed": "tsx scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:ensure": "pnpm db:migrate",
    "test:database": "tsx scripts/smoke-database.ts",
    "test:auth": "tsx scripts/smoke-auth.ts",
    "test:telegram-login": "tsx scripts/smoke-telegram-login.ts",
    "test:career-profile": "tsx scripts/smoke-career-profile.ts",
    "test:conversation": "tsx scripts/smoke-conversation.ts",
    "test:telegram-link": "tsx scripts/smoke-telegram-link.ts",
    "test:inbound": "tsx scripts/smoke-inbound.ts",
    "test:discovery": "tsx scripts/smoke-discovery.ts",
    "test:evals": "GRAVY_SCOUT_EVAL_FIXTURE=1 eve eval --tag deterministic",
    "test:evals:list": "GRAVY_SCOUT_EVAL_FIXTURE=1 eve eval --list",
    "test:evals:exit": "tsx scripts/smoke-evals-exit-code.ts",
    "capture": "tsx capture/run-capture.ts",
    "capture:dry": "tsx capture/run-capture.ts --dry-run",
    "capture:x": "tsx capture/run-capture.ts --source=x",
    "capture:linkedin": "tsx capture/run-capture.ts --source=linkedin",
    "capture:profile": "tsx capture/run-profile-capture.ts",
    "capture:profile:dry": "tsx capture/run-profile-capture.ts --dry-run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.agent.json",
    "test:scoring": "tsx scripts/smoke-scoring.ts",
    "eval": "tsx evals/run-all.ts",
    "eval:scoring": "tsx evals/run-scoring.ts",
    "eval:digest": "tsx evals/run-digest.ts",
    "eval:chat": "tsx evals/run-chat.ts",
    "eval:classify": "tsx evals/run-classify.ts",
    "eval:compare": "tsx evals/compare-models.ts",
    "eval:export": "tsx evals/export-finetune.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "@clerk/nextjs": "^7.6.4",
    "@neondatabase/serverless": "^1.1.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@vercel/connect": "0.2.2",
    "ai": "^7.0.37",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "eve": "^0.27.6",
    "jose": "^6.2.7",
    "lucide-react": "^1.28.0",
    "nanoid": "^6.0.0",
    "next": "^16.2.12",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "shadcn": "^4.16.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.4.3"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "just-bash": "^3.1.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "minimumReleaseAgeExclude": [
      "@ai-sdk/*",
      "@rolldown/*",
      "@vercel/*",
      "@workflow/*",
      "ai",
      "experimental-ai-sdk-code-mode",
      "eve",
      "nitro",
      "rolldown",
      "workflow"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@mongodb-js/zstd",
      "node-liblzma"
    ],
    "allowBuilds": {
      "esbuild": true,
      "sharp": false,
      "just-bash": true,
      "@mongodb-js/zstd": false,
      "node-liblzma": false
    },
    "packageExtensions": {
      "eve@>=0.6.0-beta.13 <=0.7.0": {
        "dependencies": {
          "oxc-parser": "0.134.0"
        }
      }
    }
  }
}
