{
  "name": "gravy-scout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:tui": "eve dev",
    "dev:no-ui": "eve dev --no-ui",
    "build": "next build",
    "build:eve": "eve build",
    "start": "next start",
    "start:eve": "eve start",
    "info": "eve info",
    "seed": "tsx scripts/seed.ts",
    "db:ensure": "tsx -e \"import { ensureSchema } from './agent/lib/db/client.ts'; await ensureSchema(); console.log('ok')\"",
    "capture": "tsx capture/run-capture.ts",
    "capture:dry": "tsx capture/run-capture.ts --dry-run",
    "capture:x": "tsx capture/run-capture.ts --source=x",
    "capture:linkedin": "tsx capture/run-capture.ts --source=linkedin",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.agent.json",
    "test:scoring": "tsx scripts/smoke-scoring.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@vercel/connect": "0.2.2",
    "ai": "^7.0.0",
    "drizzle-orm": "^0.45.2",
    "eve": "^0.23.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.4.3"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "just-bash": "^3.1.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
